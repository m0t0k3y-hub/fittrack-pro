# Supabase の接続情報
#   ローカル: `supabase start` 後の `supabase status` に表示される API URL / anon key
#   本番    : Supabase ダッシュボードの Project Settings → API（anon / publishable key。service_role は絶対に設定しない）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# アプリの公開 URL（Origin ヘッダーが無い場合のフォールバック）
#   ローカル: http://localhost:3000
#   本番    : https://<本番のドメイン>
# NEXT_PUBLIC_ で始まる値はビルド時に埋め込まれるため、変更したら再デプロイが必要。
NEXT_PUBLIC_SITE_URL=http://localhost:3000
